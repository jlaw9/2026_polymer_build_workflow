#-------------------INITIALIZATION-------------------------

units 				real
atom_style 			full
dimension 			3
boundary 			p p p

#---------------------VARIABLES----------------------------

variable	       		Temperature equal  300
variable	       		Pressure equal  1
variable    			cod1 equal 9.0
variable 			tempdamp equal 100
variable 			pressdamp equal 1000
variable			cod equal 9.0
variable 	MassinGrams equal mass(all)/6.02e23
variable 	VolumeCubicCentimeter equal vol*1.0e-24
variable 	Density equal v_MassinGrams/v_VolumeCubicCentimeter
variable	SpecificVolume equal 1.0/v_Density

#--------------------FORCE FIELD---------------------------

bond_style 			harmonic
angle_style 			harmonic
dihedral_style 			fourier
improper_style 			cvff
special_bonds 			lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333 
pair_style 			lj/cut/coul/long ${cod1} ${cod1}
pair_modify 			mix arithmetic tail yes
kspace_style 			pppm 1e-4

#---------------GENERAL SIMULATION SETTINGS------------------

read_data 			data_final-init.data

neighbor        		2.0 bin
neigh_modify    		delay 0 every 1 check yes page 1000000 one 20000

thermo_style 			custom step density etotal pe ke enthalpy lx ly lz cpu temp press ebond eangle edihed eimp epair evdwl ecoul elong etail
thermo         			1000
thermo_modify			flush yes

fix 				shk all shake 0.0001 20 0 m 1.007947
timestep			2.0

velocity 			all create ${Temperature} 4928459 dist gaussian

#------------ENSEMBLE SETUP: NPT EQUILIBRATION--------------

# NPT EQUILIBRATION (DENSITY)

fix 				dens_data all ave/time 1 1 1 v_Density file density_final-data.txt
fix           			NPT all npt temp ${Temperature} ${Temperature} ${tempdamp} iso ${Pressure} ${Pressure} ${pressdamp}
run 				2000000
unfix dens_data
unfix NPT
print "NPT equilibration is finished."
write_data 			data_density_1ns.data
write_restart			restart-npt.*


